# ~/.zshrc — WSL/Linux (Managed by c4)

# 1. Secrets & Environment
# ------------------------------------------------------------------------------
if [ -f "$HOME/.config/c4/secrets.env" ]; then
    source "$HOME/.config/c4/secrets.env"
fi

# 2. SSH Agent
# ------------------------------------------------------------------------------
if [ -z "$SSH_AUTH_SOCK" ]; then
   eval "$(ssh-agent -s)" > /dev/null
fi

# 3. Core Toolchain (Brew)
# ------------------------------------------------------------------------------
if [ -d "/home/linuxbrew/.linuxbrew/bin" ]; then
    eval "$(/home/linuxbrew/.linuxbrew/bin/brew shellenv)"
elif [ -d "$HOME/.linuxbrew/bin" ]; then
    eval "$($HOME/.linuxbrew/bin/brew shellenv)"
fi

# CUDA Paths (only if installed)
[ -d "/usr/local/cuda-13.0/bin" ] && export PATH="/usr/local/cuda-13.0/bin:$PATH"
[ -d "/usr/local/cuda-12.4/lib64" ] && export LD_LIBRARY_PATH="/usr/local/cuda-12.4/lib64:$LD_LIBRARY_PATH"

# 4. Universal Runtimes
# ------------------------------------------------------------------------------
# fnm (Node.js)
if command -v fnm &> /dev/null; then
    eval "$(fnm env --use-on-cd)"
fi

# uv (Python)
if command -v uv &> /dev/null; then
    eval "$(uv generate-shell-completion zsh)"
fi

# 5. Plugins & UX
# ------------------------------------------------------------------------------
source_brew_plugin() {
    local p="/home/linuxbrew/.linuxbrew/share/$1/$1.zsh"
    local p2="$HOME/.linuxbrew/share/$1/$1.zsh"
    if [ -f "$p" ]; then source "$p"
    elif [ -f "$p2" ]; then source "$p2"
    fi
}

source_brew_plugin "zsh-autosuggestions"
source_brew_plugin "zsh-syntax-highlighting"

# History
HISTFILE="$HOME/.zsh_history"
HISTSIZE=10000
SAVEHIST=10000
setopt APPEND_HISTORY
setopt SHARE_HISTORY
setopt INC_APPEND_HISTORY

# Aliases
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'
alias g='git'
alias c4='cd ~/projects/c4'
alias reload='source ~/.zshrc'
alias bwul='export BW_SESSION=$(bw unlock --raw)'
alias cat='bat --paging=never'
alias agy='antigravity'
alias vault='antigravity C:/Users/Oliver/Desktop/personal'

# 6. Prompt (Oh My Posh)
# ------------------------------------------------------------------------------
if command -v oh-my-posh &> /dev/null; then
    eval "$(oh-my-posh init zsh --config $(brew --prefix oh-my-posh)/themes/patriksvensson.omp.json)"
fi

# 7. Local/Host Specific Overrides
# ------------------------------------------------------------------------------
if [ -f "$HOME/.zshrc.local" ]; then
    source "$HOME/.zshrc.local"
fi
